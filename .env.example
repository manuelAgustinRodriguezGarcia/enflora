NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CRON_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=Enflora <contacto@enflora.com.ar>
CONTACT_EMAIL=enflora.420@gmail.com

# Opcional — rate limit serverless (Upstash Redis, tier gratuito)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

SUPABASE_SERVICE_ROLE_KEY=
EXPO_ADMIN_IDS=

# Mercado Pago Argentina — solo credenciales de prueba (Checkout Pro).
# MERCADOPAGO_ACCESS_TOKEN es privado del servidor.
# Checkout Pro usa el prefijo APP_USR- en Pruebas y en Producción.
# TEST- corresponde a otras credenciales de prueba (Checkout API o Bricks).
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY es la Public Key, para el frontend más adelante.
# No coloques el Access Token en una variable NEXT_PUBLIC_.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Solo entorno local, después de verificar la pestaña Pruebas. No definir en producción.
MERCADOPAGO_PRUEBAS_CONFIRMADAS=
# Correo exacto del comprador de prueba de la aplicación. Solo con MERCADOPAGO_ENV=prueba. Vacío = la orden no lleva payer.
MERCADOPAGO_TEST_BUYER_EMAIL=
# prueba o produccion. No se infiere por el prefijo del token. Vacío = no se crean órdenes.
MERCADOPAGO_ENV=
# Secreto de la firma x-signature. El de Pruebas queda solo en local. El de Producción, solo en Vercel.
MERCADOPAGO_WEBHOOK_SECRET=
# Tiene que ser exactamente true para cobrar en producción. Cualquier otro valor deja los cobros apagados.
PAYMENTS_LIVE_ENABLED=
# URL pública. En Vercel: https://enflora.com.ar. En local: http://localhost:3000
APP_URL=
