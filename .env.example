NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CRON_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=Enflora <contacto@enflora.com.ar>
CONTACT_EMAIL=enflora.420@gmail.com

# Opcional — rate limit serverless (Upstash Redis, tier gratuito)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

SUPABASE_SERVICE_ROLE_KEY=
# Administración (solo servidor). UUID de Supabase Auth (Authentication → Users → User UID).
# Formato: UUID completos separados por coma, SIN comillas ni saltos de línea ni ; | espacios internos.
#   ADMIN_IDS=11111111-1111-4111-8111-111111111111,22222222-2222-4222-8222-222222222222
# ADMIN_IDS autoriza todos los módulos; ADMIN_IDS_<MODULO> solo ese módulo
# (DASHBOARD, USUARIOS, PLANES, FLORA_IA, ALMACENAMIENTO, NOTIFICACIONES, PARTNERS, EXPO).
# La cuenta además debe tener el correo confirmado y no ser anónima. Sin valores válidos, nadie es admin.
# Una entrada inválida se descarta (fail-closed) y el servidor avisa en el log, sin imprimir el valor.
# Verificar antes de desplegar: npm run admin:verificar
ADMIN_IDS=
# ADMIN_IDS_EXPO=
# MECANISMO ANTERIOR del admin de Expo, TODAVÍA ACTIVO: quitar un UUID de ADMIN_IDS NO revoca este acceso
# (además hay un correo fijo en el código). Se retira en un paso posterior; ver auditorias/ADMIN-SPRINT1-AUTORIZACION.md.
EXPO_ADMIN_IDS=
# EXPO_ADMIN_EMAILS=

# Flora IA — chat (servidor)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Timeouts del chat (ms). Por defecto en Vercel: 58s presupuesto / 45s por llamada Gemini (maxDuration 60).
# FLORA_CHAT_TIMEOUT_PRESUPUESTO_MS=
# FLORA_CHAT_TIMEOUT_LLAMADA_GEMINI_MS=
# Opcional: firma HMAC para tokens de «Guardar solución» (default: JWT secret o GEMINI_API_KEY)
# FLORA_GUARDADO_SECRETO=

# Flora IA — guía editorial RAG (Sprint 3.5B)
# local | supabase | auto (RAG con fallback JSON temporal)
FLORA_GUIA_MOTOR=local
# Opcional: URL completa de flora-rag-retrieve si difiere del default
# FLORA_RAG_RETRIEVE_URL=
# Administradores de ingesta RAG (Edge flora-rag-admin). Validados en servidor.
FLORA_RAG_ADMIN_IDS=
FLORA_RAG_ADMIN_EMAILS=

# Mercado Pago Argentina — solo credenciales de prueba (Checkout Pro).
# MERCADOPAGO_ACCESS_TOKEN es privado del servidor.
# Checkout Pro usa el prefijo APP_USR- en Pruebas y en Producción.
# TEST- corresponde a otras credenciales de prueba (Checkout API o Bricks).
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY es la Public Key, para el frontend más adelante.
# No coloques el Access Token en una variable NEXT_PUBLIC_.
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Solo entorno local, después de verificar la pestaña Pruebas. No definir en producción.
MERCADOPAGO_PRUEBAS_CONFIRMADAS=
# Correo exacto del comprador de prueba de la aplicación. Solo con MERCADOPAGO_ENV=prueba. Vacío = la orden no lleva payer.
MERCADOPAGO_TEST_BUYER_EMAIL=
# prueba o produccion. No se infiere por el prefijo del token. Vacío = no se crean órdenes.
MERCADOPAGO_ENV=
# Secreto de la firma x-signature. El de Pruebas queda solo en local. El de Producción, solo en Vercel.
MERCADOPAGO_WEBHOOK_SECRET=
# Tiene que ser exactamente true para cobrar en producción. Cualquier otro valor deja los cobros apagados.
PAYMENTS_LIVE_ENABLED=
# Temporal. Lista de UUID (separados por coma) que pueden iniciar checkouts nuevos en Production. Vacío = sin restricción.
PAYMENTS_PILOT_USER_IDS=
# Plan Plus en producción: exactamente true habilita suscripciones y el cron de renovación.
PLUS_LIVE_ENABLED=
# Correo que recibe las alertas del cron de renovación (si falta, usa CONTACT_EMAIL).
PLUS_ALERT_EMAIL=
# Secreto del monitor externo para /api/pagos/plus/heartbeat. Distinto de CRON_SECRET.
PLUS_MONITOR_SECRET=
# Opcional: minutos máximos sin corrida del cron antes de marcar fallo (por defecto 180).
# PLUS_HEARTBEAT_EDAD_MAX_MIN
# URL pública. En Vercel: https://enflora.com.ar. En local: http://localhost:3000
APP_URL=

# Web Push. Generar el par con: pnpm exec web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY puede verse en el navegador. La privada no.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@enflora.com.ar
# Exactamente true autoriza la campaña de lanzamiento. Cualquier otro valor la deja apagada.
PUSH_LANZAMIENTO_ACTIVA=
# Secreto del envío a un solo dispositivo. Mínimo 16 caracteres. Distinto de CRON_SECRET.
PUSH_PRUEBA_SECRETO=
# Opcional. Si falta, el límite por IP usa CRON_SECRET.
PUSH_LIMITE_SAL=
